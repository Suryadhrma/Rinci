PORT=3000

# Postgres, hosted gratis (mis. Neon: https://neon.tech) -- device lokal
# tidak kuat jalanin Docker, jadi Postgres/Redis dipindah ke cloud tier gratis.
DATABASE_URL="postgresql://user:password@localhost:5432/rinci?schema=public"

# Redis buat BullMQ, hosted gratis (mis. Upstash: https://upstash.com).
# Pakai connection string TCP (rediss://...), bukan REST API URL-nya.
REDIS_URL="rediss://default:password@localhost:6379"

# Gemini API key, dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model vision yang dipakai adapter Gemini (murah-dulu, dipanggil tiap ekstraksi)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model eskalasi (Tahap 5) -- cuma dipanggil kalau confidence hasil
# GEMINI_MODEL di bawah ambang. Kosongkan buat matikan eskalasi.
GEMINI_MODEL_ESCALATION=gemini-3.5-flash

# Folder disk lokal buat simpan file upload (Tahap 0-1 saja, Tahap 2+ pindah ke MinIO)
UPLOAD_DIR=storage/uploads

# Demo publik (Tahap 7): file dokumen pengunjung dihapus otomatis setelah
# sekian jam (cron tiap jam, di proses worker). Row Postgres-nya tetap ada.
FILE_RETENTION_HOURS=24

# Kosongkan (default) -- worker jalan sebagai proses terpisah (npm run
# worker), sesuai desain Tahap 2. Set "true" cuma kalau platform deploy
# cuma kasih SATU proses gratis tanpa kartu kredit (mis. Render Web
# Service tanpa Background Worker) -- worker digabung ke proses API.
# RUN_WORKER_IN_PROCESS=true
