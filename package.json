{
  "name": "rinci",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service ekstraksi dokumen bisnis (struk, nota, faktur) jadi data terstruktur tervalidasi.",
  "license": "ISC",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "eval": "npm run build && tsx eval/run.ts",
    "eval:compare": "tsx eval/compare.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
